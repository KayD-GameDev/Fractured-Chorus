        <mxCell id="title" value="&lt;b&gt;Fractured Chorus — sơ đồ lớp thành phố, hầm, thoại, hồ sơ&lt;/b&gt;&lt;br&gt;Kim cương đặc = cấu thành. Mũi tên mở = biết / điều hướng. Nét đứt = phụ thuộc tạm." style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="780" height="40" as="geometry"/>
        </mxCell>

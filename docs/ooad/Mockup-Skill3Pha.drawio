        <mxCell id="s1a" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6E7686;strokeColor=#C5CAD3;" vertex="1" parent="1"><mxGeometry x="120" y="190" width="36" height="36" as="geometry"/></mxCell>

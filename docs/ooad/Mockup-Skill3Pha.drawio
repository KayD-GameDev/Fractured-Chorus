        <mxCell id="title" value="&lt;font color=&quot;#F4F1EA&quot;&gt;&lt;b&gt;Mockup — Skill 3 pha (S1 · S · S2)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="48" y="36" width="560" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="&lt;font color=&quot;#A8B0C0&quot;&gt;Mọi chiêu có ba pha. Beat đặt là beat đầu của pha dùng chiêu. S1 đứng trước, S2 đứng sau.&lt;/font&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="48" y="70" width="820" height="24" as="geometry"/>

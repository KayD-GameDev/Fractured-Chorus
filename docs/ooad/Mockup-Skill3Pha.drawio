        <mxCell id="cap1" value="&lt;font color=&quot;#C5CAD3&quot;&gt;&lt;b&gt;S1&lt;/b&gt; · đứng trước&lt;br&gt;2 beat&lt;/font&gt;" style="text;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="270" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="capS" value="&lt;font color=&quot;#3DDC97&quot;&gt;&lt;b&gt;S&lt;/b&gt; · đang dùng chiêu&lt;br&gt;2 beat · beat đặt = ô đầu của S&lt;/font&gt;" style="text;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="310" height="40" as="geometry"/></mxCell>
        <mxCell id="cap2" value="&lt;font color=&quot;#C5CAD3&quot;&gt;&lt;b&gt;S2&lt;/b&gt; · hồi&lt;br&gt;2 beat&lt;/font&gt;" style="text;html=1;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="270" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="rule" value="&lt;font color=&quot;#F4F1EA&quot;&gt;Cùng một người, S1, S và S2 không được đè lên nhau.&lt;br&gt;Chip xanh là màu người chơi. Nút tròn xám là hai pha đứng.&lt;br&gt;Đòn đỡ tính trên từng beat của pha S khi beat đó trùng nốt địch.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1C2230;strokeColor=#3DDC97;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="48" y="360" width="500" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="table" value="&lt;font color=&quot;#F4F1EA&quot;&gt;&lt;b&gt;Ba chiêu của Ren&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#A8B0C0&quot;&gt;Strike&amp;nbsp;&amp;nbsp;1-1-1&lt;br&gt;Crosscut&amp;nbsp;&amp;nbsp;2-2-2&lt;br&gt;Finale&amp;nbsp;&amp;nbsp;2-3-3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingTop=8;fillColor=#1C2230;strokeColor=#2C3548;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="580" y="360" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="flow" value="&lt;font color=&quot;#A8B0C0&quot;&gt;S1 đứng&amp;nbsp;→&amp;nbsp;S dùng chiêu&amp;nbsp;→&amp;nbsp;S2 hồi&lt;/font&gt;" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="48" y="500" width="420" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="&lt;font color=&quot;#8E98AA&quot;&gt;Số beat mỗi pha lấy từ định nghĩa chiêu: standingBeatsBefore, activeBeats, standingBeatsAfter. Toàn bộ pha S phải nằm trong cửa sổ planning.&lt;/font&gt;" style="text;html=1;align=left;fontSize=12;" vertex="1" parent="1">

        <mxCell id="sa" value="&lt;font color=&quot;#06281A&quot;&gt;&lt;b&gt;S&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3DDC97;strokeColor=#B8FFE0;fontSize=16;" vertex="1" parent="1"><mxGeometry x="300" y="182" width="150" height="52" as="geometry"/></mxCell>
        <mxCell id="sb" value="&lt;font color=&quot;#06281A&quot;&gt;&lt;b&gt;S&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3DDC97;strokeColor=#B8FFE0;fontSize=16;" vertex="1" parent="1"><mxGeometry x="460" y="182" width="150" height="52" as="geometry"/></mxCell>

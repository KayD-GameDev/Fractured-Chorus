  <diagram name="Lop-Combat" id="ooad-combat">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Fractured Chorus — sơ đồ lớp combat&lt;/b&gt;&lt;br&gt;Kim cương đặc = cấu thành. Kim cương rỗng = kết tập. Nét đứt = phụ thuộc. Tam giác rỗng = hiện thực giao diện." style="text;html=1;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="720" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cController" value="&lt;b&gt;«boundary»&lt;br&gt;CombatController&lt;/b&gt;&lt;hr&gt;+ Initialize(session, timeline)&lt;br&gt;+ StartRound() : void&lt;br&gt;+ ResumeFromPlanningPause() : void&lt;br&gt;+ OnRoundSegmentComplete() : void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="230" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="cSession" value="&lt;b&gt;«control»&lt;br&gt;CombatSession&lt;/b&gt;&lt;hr&gt;+ Phase : CombatPhase&lt;br&gt;+ IsPlanningWindowOpen : bool&lt;br&gt;+ TryAssignPlayerAction(...) : bool&lt;br&gt;+ ConfirmPlanningAndExecute() : void&lt;br&gt;+ OnTimelineScanBeat(beat) : void" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="250" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="cTimeline" value="&lt;b&gt;«entity»&lt;br&gt;BeatTimelineEngine&lt;/b&gt;&lt;hr&gt;+ Phase : CombatPhase&lt;br&gt;+ ScanBeatIndex : int&lt;br&gt;+ Agenda : AgendaEntry[*]&lt;br&gt;+ Telegraphs : EnemyTelegraph[*]&lt;br&gt;+ OnScanAdvanced : event" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="60" width="240" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="cIMusic" value="&lt;b&gt;«interface»&lt;br&gt;ICombatMusicSync&lt;/b&gt;&lt;hr&gt;+ đồng hồ beat tuyệt đối&lt;br&gt;+ báo beat cho timeline" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=12;" vertex="1" parent="1">
